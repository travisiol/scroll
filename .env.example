# Copy to .env.local. Nothing here is a real secret; never commit real values.

# ── Reviewers ───────────────────────────────────────────────────────────
# Comma-separated wallet addresses allowed into /admin. Checked on the
# server on every request. Leave empty and nobody is a reviewer. To find
# your address: sign in, open /admin, and copy the address it shows.
ADMIN_WALLETS=

# ── Security (required in production) ───────────────────────────────────
# 32+ random characters. Signs the short-lived screenshot URLs.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Public origin(s) users sign in from, comma-separated, e.g. https://scroll.example
# When empty, sign-in accepts the host each request arrives on (fine locally).
APP_ORIGINS=

# ── Database ────────────────────────────────────────────────────────────
# When empty, an embedded Postgres (PGlite) is stored in data/local and
# migrates itself. For production, point this at PostgreSQL
# and run `npm run db:migrate`.
DATABASE_URL=

# ── Settlement: Robinhood Chain (chain ID 4663) ─────────────────────────
# Dedicated RPC endpoint. The public one is rate-limited and not meant for
# production (https://docs.robinhood.com/chain/connecting).
RPC_URL=
# Private key of the wallet that holds the reward tokens and a little ETH
# for gas. Server-side only. Without it, payouts stay disabled and the
# app says so. NEVER prefix this with NEXT_PUBLIC_.
TREASURY_PRIVATE_KEY=

# ── Scheduled worker ────────────────────────────────────────────────────
# 16+ characters. Enables POST /api/cron/payouts (payout queue + screenshot
# retention). `npm run worker` sends it as a Bearer token.
CRON_SECRET=

# ── Optional limits (defaults shown) ────────────────────────────────────
# NEXT_PUBLIC_UPLOAD_MAX_BYTES=8388608
# NEXT_PUBLIC_UPLOAD_MIN_WIDTH=320
# NEXT_PUBLIC_UPLOAD_MIN_HEIGHT=480
# NEXT_PUBLIC_UPLOAD_MAX_DIMENSION=6000
# NEXT_PUBLIC_UPLOAD_MAX_FILES=4
# NEXT_PUBLIC_WEEKS_BACK=4
# NEXT_PUBLIC_EVIDENCE_RETENTION_DAYS=90
# NEXT_PUBLIC_WEEK_STARTS_ON=0   # 0 = Sunday (iOS weekly report), 1 = Monday
